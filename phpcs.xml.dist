<?xml version="1.0"?>
<ruleset name="WordPress Theme Coding Standards">
	<arg name="extensions" value="php" />
	<arg name="colors" />
	<arg name="parallel" value="16" />
	<arg value="sp" />

	<!-- Lint all PHP files in the project directory by default. -->
	<file>.</file>

	<!-- Ensure all code works with PHP 8.2 and above. -->
	<rule ref="PHPCompatibilityWP" />
	<config name="testVersion" value="8.2-" />

	<rule ref="WordPress-Core">
		<exclude name="Universal.Arrays.DisallowShortArraySyntax" />
		<exclude name="Generic.Commenting.DocComment.MissingShort" />
		<exclude name="PSR2.Classes.PropertyDeclaration.Underscore" />
	</rule>

	<!-- Force short array syntax -->
	<rule ref="Generic.Arrays.DisallowLongArraySyntax.Found">
		<type>warning</type>
	</rule>

	<rule ref="WordPress" />
	<rule ref="WordPress-Extra"/>
	<rule ref="WordPress-Docs" />
	<rule ref="WordPress-VIP-Go"/>
	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="eutopia-theme" />
			</property>
		</properties>
	</rule>

	<exclude-pattern>*/assets/*</exclude-pattern>
	<exclude-pattern>*/tools/wordpress/*</exclude-pattern>
	<exclude-pattern>*/tools/wp-content/*</exclude-pattern>
	<exclude-pattern>*/node_modules/*</exclude-pattern>
	<exclude-pattern>*/tests/coverage/*</exclude-pattern>
	<exclude-pattern>*/vendor/*</exclude-pattern>
	<exclude-pattern>*/*.asset.php</exclude-pattern>
</ruleset>
