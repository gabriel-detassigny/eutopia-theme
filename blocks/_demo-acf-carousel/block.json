{
	"$schema": "https://json.schemastore.org/block.json",
	"apiVersion": 2,
	"version": "1.0.0",
	"name": "gabriel-detassigny/demo-acf-carousel",
	"title": "DEMO Carousel",
	"category": "gabriel-detassigny-blocks",
	"icon": "no",
	"description": "A custom carousel block.",
	"keywords": [
		"testimonial",
		"quote"
	],
	"textdomain": "eutopia-theme",
	"supports": {
