{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 2,
	"name": "gabriel-detassigny/icon",
	"version": "1.0.0",
	"title": "Icon",
	"category": "gabriel-detassigny-blocks",
	"keywords": [
		"icon"
	],
	"icon": "art",
	"textdomain": "eutopia-theme",
	"description": "Icon block.",
	"attributes": {
		"iconSize": {
			"type": "number",
			"default": "24"
		},
		"icon": {
			"type": "string",
			"default": "wordpress-alt"
		},
		"source": {
			"type": "string",
			"selector": "div.gabriel-detassigny-icon",
			"source": "html"
		},
		"iconCollection": {
			"type": "string",
			"default": "core/dashicon"
		}
	},
	"example": {},
	"supports": {
		"html": true
	},
	"editorScript": "file:editor.js",
	"editorStyle": "file:editor.css"
}
