{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 2,
	"name": "gabriel-detassigny/spacer",
	"title": "Spacer",
	"category": "gabriel-detassigny-blocks",
	"description": "Add white space between blocks and customize its height.",
	"textdomain": "eutopia-theme",
	"attributes": {
		"mobileHeight": {
			"type": "string",
			"default": "m"
		},
		"tabletHeight": {
			"type": "string",
			"default": "m"
		},
		"height": {
			"type": "string",
			"default": "m"
		}
	},
	"supports": {
		"anchor": true
	},
	"editorScript": "file:./editor.js",
	"editorStyle": "file:./editor.css",
	"script": "file:./script.js",
	"style": "file:./script.css"
}
