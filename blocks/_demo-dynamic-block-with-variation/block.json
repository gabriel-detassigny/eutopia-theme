{
	"$schema": "https://json.schemastore.org/block.json",
	"apiVersion": 2,
	"version": "1.0.0",
	"name": "gabriel-detassigny/demo-dynamic-block-with-variation",
	"title": "DEMO Block with Variation",
	"category": "gabriel-detassigny-blocks",
	"icon": "no",
	"description": "Basic dynamic block with variations",
	"keywords": [
		"eutopia-theme",
		"variation"
	],
	"textdomain": "eutopia-theme",
	"supports": {
		"customClassName": true,
		"html": false,
		"anchor": false
	},
	"attributes": {
		"content": {
			"type": "string",
			"default": "Lorem Ipsum"
		},
		"slug": {
			"type": "string",
			"default": "eutopia-theme"
		}
	},
	"example": {
		"slug": "eutopia-theme"
	},
	"variations": [
		{
			"icon": "no-alt",
			"name": "demo-dynamic-block-with-variation-two",
			"title": "Block with Variation Two",
			"attributes": {
				"content": "WordPress",
				"slug": "wordpress"
			}
		}
	],
	"editorScript": "file:./editor.js"
}
