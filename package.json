{
	"name": "eutopia-theme",
	"private": true,
	"description": "Eutopia Theme WordPress theme",
	"author": "Gabriel de Tassigny",
	"license": "GPL-2.0-or-later",
	"keywords": [
		"WordPress",
		"Theme"
	],
	"engines": {
		"node": ">=18.0.0"
	},
	"devDependencies": {
		"@10up/block-components": "1.18.0",
		"@typescript-eslint/eslint-plugin": "^7.5.0",
		"@typescript-eslint/parser": "7.4.0",
		"@wordpress/block-editor": "12.22.0",
		"@wordpress/blocks": "12.31.0",
		"@wordpress/components": "27.2.0",
		"@wordpress/compose": "6.31.0",
		"@wordpress/data": "9.24.0",
		"@wordpress/dom-ready": "3.54.0",
		"@wordpress/edit-post": "7.31.0",
		"@wordpress/element": "5.31.0",
		"@wordpress/env": "9.6.0",
		"@wordpress/eslint-plugin": "17.11.0",
		"@wordpress/i18n": "4.54.0",
		"@wordpress/icons": "9.45.0",
		"@wordpress/plugins": "6.22.0",
		"@wordpress/rich-text": "6.31.0",
		"@wordpress/scripts": "27.5.0",
		"@wordpress/stylelint-config": "21.37.0",
		"ajv": "^8.12.0",
		"ajv-errors": "^3.0.0",
		"classnames": "2.5.1",
		"eslint-plugin-jest": "^28.2.0",
		"eslint-plugin-react-hooks": "4.6.0",
		"glob": "10.3.12",
		"lint-staged": "14.0.1",
		"lodash": "4.17.21",
		"npm-run-all2": "6.1.2",
		"postcss-preset-env": "9.5.2",
		"requestidlecallback-polyfill": "1.0.2",
		"sortablejs": "1.15.2",
		"stylelint": "14.16.1",
		"stylelint-use-logical": "2.1.2",
		"webpack-remove-empty-scripts": "1.0.4",
		"webpackbar": "6.0.1",
		"whatwg-fetch": "3.6.20"
	},
	"scripts": {
		"dev": "npm-run-all --parallel dev:*",
		"dev:build": "wp-scripts start --hot --mode development",
		"dev:test-js": "wp-scripts test-unit-js --watch",
		"build": "npm-run-all --parallel build:*",
		"build:assets": "wp-scripts build",
		"build:pot": "composer make-pot",
		"lint": "npm-run-all --parallel lint:*",
		"lint:css": "wp-scripts lint-style",
		"lint:js": "wp-scripts lint-js --ext .jsx,.js,.mjs",
		"lint:php": "composer lint",
		"lint:theme-json": "node ./tools/theme-json-lint/index.mjs",
		"format": "npm-run-all --parallel format:*",
		"format:css": "npm run lint:css -- --fix",
		"format:js": "npm run lint:js -- --fix",
		"format:php": "composer format",
		"test": "npm-run-all test:*",
		"test:php": "wp-env run tests-cli --env-cwd=/var/www/html/wp-content/themes/eutopia-theme/ vendor/bin/phpunit",
		"test:js": "wp-scripts test-unit-js",
		"env": "wp-env",
		"start": "wp-env start",
		"start:xdebug": "wp-env start --xdebug",
		"stop": "wp-env stop",
		"stop-all": "docker stop $(docker ps -a -q)",
		"composer": "wp-env run composer",
		"wp": "wp-env run cli",
		"media:regenerate": "npm run wp -- wp media regenerate --yes",
		"prepare": "git config core.hooksPath ./tools/git-hooks",
		"scaffold": "plop --plopfile ./tools/scaffold/plopfile.mjs",
		"push:develop": "currentBranch=$(git rev-parse --abbrev-ref HEAD) && git checkout develop && git pull && git merge $currentBranch && git push origin develop && git checkout $currentBranch",
		"pull:main": "currentBranch=$(git rev-parse --abbrev-ref HEAD) && git checkout main && git pull origin main && git checkout $currentBranch && git merge main && git push origin $currentBranch"
	},
	"dependencies": {
		"minimist": "^1.2.8",
		"plop": "4.0.0",
		"swiper": "11.1.0",
		"uuid": "^9.0.0"
	},
	"lint-staged": {
		"*.{css,sass,scss}": [
			"npm run format:css",
			"npm run lint:css"
		],
		"*.{js,jsx,mjs}": [
			"npm run format:js",
			"npm run lint:js"
		],
		"*.php": "npm run lint:php"
	}
}
