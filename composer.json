{
	"name": "gabriel-detassigny/eutopia-theme",
	"type": "wordpress-theme",
	"description": "Eutopia Theme WordPress theme",
	"license": "GPL-2.0-or-later",
	"minimum-stability": "dev",
	"prefer-stable": true,
	"config": {
		"sort-packages": true,
		"platform": {
			"php": "8.2",
			"ext-filter": "7.1"
		},
		"allow-plugins": {
			"roots/wordpress-core-installer": true,
			"dealerdirect/phpcodesniffer-composer-installer": true,
			"ffraenz/private-composer-installer": true,
			"composer/installers": true,
			"phpstan/extension-installer": true
		}
	},
	"extra": {
		"wordpress-install-dir": "tools/wordpress",
		"installer-paths": {
			"tools/wp-content/plugins/{$name}/": [
				"type:wordpress-plugin"
			]
		}
	},
	"repositories": [
		{
			"type": "composer",
			"url": "https://repo.packagist.com/private/",
			"only": [
				"wpengine/advanced-custom-fields-pro"
			]
		},
		{
			"type": "composer",
			"url": "https://wpackagist.org",
			"only": [
				"wpackagist-plugin/*"
			]
		}
	],
	"require": {
		"php": ">=8.2",
		"enshrined/svg-sanitize": "^0.18.0",
		"wpengine/advanced-custom-fields-pro": "6.1.1"
	},
	"require-dev": {
		"automattic/vipwpcs": "dev-develop",
		"dealerdirect/phpcodesniffer-composer-installer": "1.0.0",
		"phpcompatibility/php-compatibility": "dev-develop as 9.99.99",
		"phpcompatibility/phpcompatibility-wp": "2.1.4",
		"phpstan/extension-installer": "1.3.1",
		"phpstan/phpstan": "1.10.66",
		"phpunit/phpunit": "9.6.18",
		"roots/wordpress": "6.4.3",
		"szepeviktor/phpstan-wordpress": "^1.1",
		"wp-cli/i18n-command": "2.6.1",
		"wp-cli/wp-cli-bundle": "2.10.0",
		"wp-phpunit/wp-phpunit": "6.4.3",
		"yoast/phpunit-polyfills": "2.0.0"
	},
	"scripts": {
		"lint": [
			"@composer lint:phpcs"
		],
		"lint:phpcs": "phpcs",
		"lint:phpstan": "phpstan analyse --memory-limit=1024M",
		"format": "phpcbf",
		"make-pot": "wp i18n make-pot . ./languages/eutopia-theme.pot --exclude=tools,build",
		"test": "phpunit",
		"wp": "wp"
	}
}
