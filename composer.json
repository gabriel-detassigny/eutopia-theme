{
	"name": "gabriel-detassigny/eutopia-theme",
	"type": "wordpress-theme",
	"description": "Eutopia WordPress theme",
	"license": "GPL-2.0-or-later",
	"config": {
		"sort-packages": true,
		"platform": {
			"php": "8.2",
			"ext-filter": "7.1"
		},
		"allow-plugins": {
			"roots/wordpress-core-installer": true,
			"dealerdirect/phpcodesniffer-composer-installer": true,
			"composer/installers": true,
			"phpstan/extension-installer": true
		}
	},
	"extra": {
		"wordpress-install-dir": "tools/wordpress",
		"installer-paths": {
			"tools/wp-content/plugins/{$name}/": [
				"type:wordpress-plugin"
			]
		}
	},
	"repositories": [
		{
			"type": "composer",
			"url": "https://wpackagist.org",
			"only": [
				"wpackagist-plugin/*"
			]
		}
	],
	"require": {
		"php": ">=8.2",
		"enshrined/svg-sanitize": "^1.1"
	},
	"require-dev": {
		"automattic/vipwpcs": "^3.1",
		"dealerdirect/phpcodesniffer-composer-installer": "^1.2",
		"phpcompatibility/phpcompatibility-wp": "^2.1.8",
		"phpstan/extension-installer": "^1.4",
		"phpstan/phpstan": "^2.1",
		"phpunit/phpunit": "^9.6",
		"roots/wordpress": "^7.1",
		"szepeviktor/phpstan-wordpress": "^2.0",
		"wp-cli/i18n-command": "^2.6",
		"wp-cli/wp-cli-bundle": "^2.12",
		"wp-phpunit/wp-phpunit": "^7.1",
		"yoast/phpunit-polyfills": "^4.0"
	},
	"scripts": {
		"lint": [
			"@composer lint:phpcs",
			"@composer lint:phpstan"
		],
		"lint:phpcs": "phpcs",
		"lint:phpstan": "phpstan analyse --memory-limit=1024M",
		"format": "phpcbf",
		"make-pot": "wp i18n make-pot . ./languages/eutopia-theme.pot --exclude=tools,build",
		"test": "phpunit",
		"wp": "wp"
	}
}
